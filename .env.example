# Скопируйте в .env:  cp .env.example .env
# Для запуска через docker compose менять ничего не обязательно.
# Адреса сервисов внутри docker-сети заданы в docker-compose.yml; *_PORT ниже — порты на вашей машине
# (поменяйте, если порт занят). HOST=localhost нужен только для запуска скриптов с хоста.

# --- порты на хосте ---
APP_PORT=8000
# порт для проверочного скрипта организаторов (eval/participant_test.sh)
EVAL_PORT=8080
FRONTEND_PORT=5173
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL ---
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__DB_NAME=app
DATABASE__DB_SCHEMA=public
DATABASE__USER=app
DATABASE__PASSWORD=appsecret

# --- Qdrant (векторный поиск) ---
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__GRPC_PORT=6334
QDRANT__API_KEY=

# --- Redis ---
REDIS__HOST=localhost
REDIS__PORT=6379

# --- MinIO (фото вин) ---
MINIO__HOST=localhost
MINIO__PORT=9000
MINIO__ACCESS_KEY=minio
MINIO__SECRET_KEY=miniosecret
MINIO__BUCKET=wine

# --- LLM для распознавания текста этикеток (необязательно, см. README и ./run_llm.sh) ---
# Без LLM поиск работает по изображению, без уточнения по тексту этикетки.
LLM__BASE_URL=http://host.docker.internal:1234/v1
LLM__MODEL_NAME=qwen/qwen3-vl-4b
LLM__API_KEY=NONE
# не больше одного запроса к LLM одновременно
RATE_LIMITER__LIMITERS='[{"prefix":"llm","name":"llm","mode":"semaphore","capacity":1,"max_sleep":30.0,"semaphore":{"expiry":30}}]'

# --- модели (пути внутри контейнера; файлы готовит ./prepare_models или сервис models-init) ---
YOLO__BOTTLE_MODEL_PATH=/models/yolo/yolo26x.pt
YOLO__LABEL_MODEL_PATH=/models/yolo/label.pt
EMBEDDINGS__MODEL_ID=google/siglip2-base-patch16-384
EMBEDDINGS__MODEL_DIR=/models/siglip2_384
EMBEDDINGS__DEVICE=auto
# дообученный адаптер векторов (scripts/train_view_adapter.py); пусто — исходные векторы SigLIP2
EMBEDDINGS__ADAPTER_PATH=/models/adapter/siglip2_384_views.npz

# --- поиск ---
# не ждать OCR, если визуальный top-1 лучше top-2 больше чем на 30% (0 — всегда OCR)
SEARCH__OCR_SKIP_VISUAL_GAP=0.30
# ...и только если визуальный скор top-1 не ниже 0.60 (слабое совпадение всегда проверяем текстом)
SEARCH__OCR_SKIP_MIN_SCORE=0.60

# --- пользователи ---
# секрет для JWT: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__JWT_SECRET=
AUTH__ACCESS_TOKEN_TTL_MINUTES=10080
# сколько хранится история поиска без входа
AUTH__ANON_HISTORY_TTL_HOURS=72

# напоминания «вы недавно смотрели вина, что-то взяли?» через DELAY_MINUTES после последнего поиска
NOTIFICATIONS__ENABLED=true
NOTIFICATIONS__DELAY_MINUTES=60
NOTIFICATIONS__MAX_AGE_HOURS=24
NOTIFICATIONS__CHECK_INTERVAL_SECONDS=60

# --- frontend ---
# домены/IP (кроме localhost), с которых открывают сайт, через запятую; "*" — любые
VITE_ALLOWED_HOSTS=
